# Nombre del servicio systemd (usado por deploy.sh)
SERVICE_NAME=civil-web

# Django settings
SECRET_KEY=tu-secret-key-super-segura-aqui
DEBUG=False  # ✅ CAMBIAR: False por defecto para evitar copiar en producción
ALLOWED_HOSTS=localhost,127.0.0.1
MODULOS_ACTIVOS=equivalencias,carrera_academica,planta_docente,digesto
DEPARTAMENTO=civil # Opciones: civil, industrial

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@ejemplo.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion

# Default from email
DEFAULT_FROM_EMAIL=noreply@ejemplo.com