# Nombre del servicio systemd (usado por deploy.sh)
SERVICE_NAME=civil-web

# Django settings
SECRET_KEY=tu-secret-key-super-segura-aqui
DEBUG=False  # ✅ CAMBIAR: False por defecto para evitar copiar en producción
ALLOWED_HOSTS=localhost,127.0.0.1
MODULOS_ACTIVOS=equivalencias,carrera_academica,planta_docente,digesto
DEPARTAMENTO=civil # Opciones: civil, industrial

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email settings
# EMAIL_HOST/PORT/USE_TLS son opcionales -- si no se definen, usan Office365 por
# defecto. EMAIL_HOST_USER tambien se usa como remitente (DEFAULT_FROM_EMAIL).
# OJO: la contraseña se lee de SMTP_PASS, no de EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@ejemplo.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Para desarrollo local con Mailpit (https://mailpit.axllent.org/) en vez de
# mandar mails reales, comentar lo de arriba y usar:
#   mailpit.exe --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025 --smtp-auth-accept-any --smtp-auth-allow-insecure
#EMAIL_HOST=127.0.0.1
#EMAIL_PORT=1025
#EMAIL_USE_TLS=False

# Portal de Jurados (enlaces personales, sin login)
PORTAL_JURADOS_ENABLED=False
PORTAL_JURADO_TOKEN_DIAS_VALIDEZ=60
PORTAL_JURADO_SESSION_MINUTOS=60