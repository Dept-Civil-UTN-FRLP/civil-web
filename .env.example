# Nombre del servicio systemd (usado por deploy.sh)
SERVICE_NAME=civil-web

# Django settings
SECRET_KEY=tu-secret-key-super-segura-aqui
DEBUG=False  # ✅ CAMBIAR: False por defecto para evitar copiar en producción
ALLOWED_HOSTS=localhost,127.0.0.1
MODULOS_ACTIVOS=equivalencias,carrera_academica,planta_docente,digesto
DEPARTAMENTO=civil # Opciones: civil, industrial

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@ejemplo.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion

# Default from email
DEFAULT_FROM_EMAIL=noreply@ejemplo.com

# ============================================================================
# Agente de Correo (IA) — lectura O365 + análisis LLM + notificación Telegram
# Ver issues/agente_mail/ para el plan completo. Activar recién con las 9 variables
# de abajo cargadas y el flujo de autenticación (paso 04) ya completado una vez.
# ============================================================================
AGENTE_MAIL_ENABLED=False

# Azure AD / Microsoft Graph (permisos delegados). Se consiguen registrando una app en
# https://entra.microsoft.com > Identity > Applications > App registrations > New registration.
# CLIENT_ID y TENANT_ID están en la página "Overview" de la app ya creada.
# CLIENT_SECRET se genera en "Certificates & secrets" > New client secret (solo se muestra una
# vez al crearlo — copiarlo ahí mismo). Detalle paso a paso en
# issues/agente_mail/09_checklist_puesta_en_marcha.md § 1.
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_TENANT_ID=
O365_REDIRECT_URI=https://dicivil.frlp.utn.edu.ar/agente-mail/microsoft/callback/

# Telegram. TELEGRAM_BOT_TOKEN: hablarle a @BotFather en Telegram, mandar /newbot y seguir el
# asistente — el token viene en la respuesta final.
# TELEGRAM_ADMIN_CHAT / TELEGRAM_ADMIN_IDS: tu user_id de Telegram (no es secreto). Mandale
# cualquier mensaje a tu bot y después abrí https://api.telegram.org/bot<TOKEN>/getUpdates —
# el número está en "message.from.id" del JSON de respuesta. En un chat privado con el bot,
# TELEGRAM_ADMIN_CHAT y el único valor de TELEGRAM_ADMIN_IDS son el mismo número.
# TELEGRAM_WEBHOOK_SECRET: lo generás vos mismo, no viene de ningún lado externo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT=
TELEGRAM_ADMIN_IDS=

# LLM — Gemini (gemini-2.5-flash, free tier). Se consigue en
# https://aistudio.google.com/apikey > Create API key (pide loguearse con una cuenta de Google).
GEMINI_API_KEY=